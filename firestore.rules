rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidClient(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'phone', 'address', 'createdAt']) &&
             data.keys().size() >= 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.address is string && data.address.size() <= 1000;
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['id', 'type', 'docNumber', 'date', 'clientId', 'items', 'subtotal', 'tax', 'discount', 'total', 'status', 'createdBy']) &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['DRAFT', 'SENT', 'PAID', 'CANCELLED'];
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(clientId) && isValidClient(request.resource.data);
      allow update: if isSignedIn() && isValidClient(request.resource.data);
      allow delete: if isSignedIn();
    }

    // Documents Collection
    match /documents/{documentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(documentId) && isValidDocument(request.resource.data);
      allow update: if isSignedIn() && isValidDocument(request.resource.data);
      allow delete: if isSignedIn();
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
